<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Mengizinkan koneksi HTTP biasa khusus untuk IP lokal/LAN server Rumah -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
